# Copy to .env  (never commit .env)
# Generate a secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
PORT=3000
# Where the SQLite file lives (use a persistent disk in production)
DB_PATH=./data.db
# Comma-separated origins allowed to call the API from a native app / other site
CORS_ORIGINS=capacitor://localhost,http://localhost,https://localhost
